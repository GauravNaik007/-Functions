        "# Question 7: Integrate LangChain with a third-party API (e.g., weather, news) and show how responses can be generated via LLMs.\n",
        "\n",
        "## Answer\n",
        "\n",
        "\n",
        "\"\"\"### Explanation\n",
        "\n",
        "1. **API integration:** Open-Meteo provides current weather information for the requested city.\n",
        "2. **Prompt template:** LangChain combines the weather data with the user's question.\n",
        "3. **LLM processing:** OpenAI's language model interprets the supplied data and generates a readable response.\n",
        "4. **Output parser:** `StrOutputParser()` converts the LLM response into plain text.\n",
        "5. **Final response:** The user receives a natural-language weather summary.\n",
        "\n",
        "### Conclusion\n",
        "\n",
        "Integrating LangChain with a third-party API enables an LLM to use external, up-to-date information rather than relying only on its training data. This approach can be applied to weather assistants, news applications and other AI-powered systems.\n",
        "\n",
        "\n",
        "# Install the required libraries:\n",
        "# pip install langchain langchain-openai requests\"\"\"\n",
        "!pip install langchain langchain-openai requests\n",
        "\n",
        "# STEP 1: Import required libraries\n",
        "\n",
        "import os\n",
        "import requests\n",
        "from getpass import getpass\n",
        "\n",
        "from langchain_openai import ChatOpenAI\n",
        "from langchain_core.prompts import PromptTemplate\n",
        "from langchain_core.output_parsers import StrOutputParser\n",
        "\n",
        "# STEP 2: Configure the OpenAI LLM\n",
        "\n",
        "os.environ[\"OPENAI_API_KEY\"] = getpass(\"Enter OpenAI API key: \")\n",
        "\n",
        "llm = ChatOpenAI(\n",
        "    model=\"gpt-4o-mini\",\n",
        "    temperature=0.3\n",
        ")\n",
        "\n",
        "# STEP 3: Get weather data from a third-party API\n",
        "\n",
        "def get_weather(city):\n",
        "\n",
        "    # Find the city's latitude and longitude\n",
        "    url = \"https://geocoding-api.open-meteo.com/v1/search\"\n",
        "\n",
        "    response = requests.get(\n",
        "        url,\n",
        "        params={\"name\": city, \"count\": 1, \"language\": \"en\"},\n",
        "        timeout=20\n",
        "    )\n",
        "    response.raise_for_status()\n",
        "\n",
        "    places = response.json().get(\"results\", [])\n",
        "\n",
        "    if not places:\n",
        "        raise ValueError(\"City not found.\")\n",
        "\n",
        "    place = places[0]\n",
        "\n",
        "    # Fetch current weather for the selected city\n",
        "    weather_url = \"https://api.open-meteo.com/v1/forecast\"\n",
        "\n",
        "    response = requests.get(\n",
        "        weather_url,\n",
        "        params={\n",
        "            \"latitude\": place[\"latitude\"],\n",
        "            \"longitude\": place[\"longitude\"],\n",
        "            \"current\": (\n",
        "                \"temperature_2m,relative_humidity_2m,\"\n",
        "                \"apparent_temperature,precipitation,\"\n",
        "                \"weather_code,wind_speed_10m\"\n",
        "            ),\n",
        "            \"timezone\": \"auto\"\n",
        "        },\n",
        "        timeout=20\n",
        "    )\n",
        "    response.raise_for_status()\n",
        "\n",
        "    current = response.json()[\"current\"]\n",
        "\n",
        "    weather_codes = {\n",
        "        0: \"Clear sky\",\n",
        "        1: \"Mainly clear\",\n",
        "        2: \"Partly cloudy\",\n",
        "        3: \"Overcast\",\n",
        "        45: \"Fog\",\n",
        "        48: \"Depositing rime fog\",\n",
        "        51: \"Light drizzle\",\n",
        "        53: \"Moderate drizzle\",\n",
        "        55: \"Dense drizzle\",\n",
        "        61: \"Slight rain\",\n",
        "        63: \"Moderate rain\",\n",
        "        65: \"Heavy rain\",\n",
        "        80: \"Rain showers\",\n",
        "        95: \"Thunderstorm\"\n",
        "    }\n",
        "\n",
        "    return {\n",
        "        \"city\": place[\"name\"],\n",
        "        \"country\": place.get(\"country\", \"\"),\n",
        "        \"time\": current[\"time\"],\n",
        "        \"temperature_c\": current[\"temperature_2m\"],\n",
        "        \"feels_like_c\": current[\"apparent_temperature\"],\n",
        "        \"humidity_percent\": current[\"relative_humidity_2m\"],\n",
        "        \"wind_speed_kmh\": current[\"wind_speed_10m\"],\n",
        "        \"precipitation_mm\": current[\"precipitation\"],\n",
        "        \"conditions\": weather_codes.get(\n",
        "            current[\"weather_code\"], \"Other conditions\"\n",
        "        )\n",
        "    }\n",
        "\n",
        "# STEP 4: Create a prompt template\n",
        "\n",
        "prompt = PromptTemplate(\n",
        "    input_variables=[\"weather_data\", \"question\"],\n",
        "    template=\"\"\"\n",
        "    You are a helpful weather assistant.\n",
        "\n",
        "    Use the following weather data to answer the user's question\n",
        "    clearly and briefly. Do not invent weather information.\n",
        "\n",
        "    Weather data:\n",
        "    {weather_data}\n",
        "\n",
        "    User question:\n",
        "    {question}\n",
        "\n",
        "    Answer:\n",
        "    \"\"\"\n",
        ")\n",
        "\n",
        "# STEP 5: Create the LangChain pipeline\n",
        "\n",
        "chain = prompt | llm | StrOutputParser()\n",
        "\n",
        "# STEP 6: Get user input and generate a response\n",
        "\n",
        "city = input(\"Enter city: \")\n",
        "question = input(\"Ask a weather question: \")\n",
