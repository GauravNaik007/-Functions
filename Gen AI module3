        "        \"question\": question\n",
        "    })\n",
        "\n",
        "    print(\"\\nLLM Response:\")\n",
        "    print(answer)\n",
        "\n",
        "except (requests.RequestException, ValueError, KeyError) as error:\n",
        "    print(\"Error:\", error)\n",
        "\n"
